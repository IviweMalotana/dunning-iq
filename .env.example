# ─────────────────────────────────────────────────────────────────────────────
# Dunning IQ — environment template. Copy to `.env` and fill in. NEVER commit .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# --- Database -----------------------------------------------------------------
# Local dev defaults to a zero-setup SQLite file if this is left unset.
# Production (Railway) uses managed Postgres, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dunning_iq
# Railway/Heroku-style schemes (postgres://, postgresql://) are auto-upgraded.
# DATABASE_URL=

# --- LLM agent ----------------------------------------------------------------
# Which provider drives the live agent. Without a key for the selected
# provider, the engine falls back to a deterministic billing playbook.
LLM_PROVIDER=kimi   # kimi | claude

# Kimi (Moonshot AI) — default. OpenAI-compatible API.
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_MODEL=kimi-k2-0711-preview
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Anthropic Claude — kept available behind LLM_PROVIDER=claude.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLAUDE_MODEL=claude-opus-4-8

# Shared per-decision output cap.
AGENT_MAX_TOKENS=1024

# --- Webhooks -----------------------------------------------------------------
# Shared secret used to verify inbound Stripe/Paddle-style payment webhooks.
WEBHOOK_SIGNING_SECRET=whsec_demo_replace_me

# --- CORS ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (web) -----------------------------------------------------------
# Base URL the Next.js app uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
