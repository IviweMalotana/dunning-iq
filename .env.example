# ─────────────────────────────────────────────────────────────────────────────
# Dunning IQ — environment template. Copy to `.env` and fill in. NEVER commit .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# --- Database -----------------------------------------------------------------
# Local dev defaults to a zero-setup SQLite file if this is left unset.
# Production (Railway) uses managed Postgres, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dunning_iq
# DATABASE_URL=

# --- Anthropic / agent --------------------------------------------------------
# Required for the LIVE agent (classification, retry strategy, message drafting).
# Without it, the API serves the pre-generated demo decisions only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENT_MODEL=claude-opus-4-8

# --- Webhooks -----------------------------------------------------------------
# Shared secret used to verify inbound Stripe/Paddle-style payment webhooks.
WEBHOOK_SIGNING_SECRET=whsec_demo_replace_me

# --- CORS ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend (web) -----------------------------------------------------------
# Base URL the Next.js app uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
